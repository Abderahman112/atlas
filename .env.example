# --- required ---
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Leave empty, send /start to your bot, then paste the id it replies with.
TELEGRAM_OWNER_ID=

# --- calendar feeds (read-only ICS links), comma-separated "Label|URL" ---
# Avenue to Learn:   Calendar > Subscribe > copy the feed URL
# School Outlook:    Outlook web > Settings > Calendar > Shared calendars > Publish > ICS link
# iCloud:            Calendar app > calendar > Share > Public Calendar > copy link (webcal://...)
ICS_FEEDS=Avenue|https://...,Outlook|https://...,iCloud|webcal://...

# --- optional ---
# Models: claude-haiku-4-5 (cheapest, default), claude-sonnet-5, claude-opus-5 (smartest)
# ATLAS_MODEL=claude-haiku-4-5
# ATLAS_SPECIALIST_MODEL=claude-haiku-4-5
# ATLAS_TRIAGE_MODEL=claude-haiku-4-5
# ATLAS_ORCHESTRATOR_EFFORT=medium   (Sonnet/Opus only)
# ATLAS_SPECIALIST_EFFORT=low
# ATLAS_HISTORY=12
# ATLAS_INBOX_MINUTES=60
# ATLAS_TIMEZONE=America/Toronto
# COOP_TRACKER=data/Co-op Tracker.xlsx
# QUIET_START_HOUR=23
# QUIET_END_HOUR=7
